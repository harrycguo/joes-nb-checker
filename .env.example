PRODUCT_URL=https://www.joesnewbalanceoutlet.com/your-product-page
TARGET_SIZE=Womens 7

# Optional direct Product-Variation endpoint. The checker can derive this for
# Joe's URLs, so only set it if you want to override the derived endpoint.
PRODUCT_VARIATION_URL=

# Optional Discord notification.
DISCORD_WEBHOOK_URL=

# Optional email notification through Resend.
RESEND_API_KEY=
EMAIL_TO=
EMAIL_FROM=

# Optional verbose logging.
DEBUG_STOCK_CHECKER=false
